{
  "purpose": "Measure Triangle and Star full-chain response using the two small scintillators as a particle reference.",
  "detector_mapping": {
    "scope_A": "Triangle_SIPM1_top_large_PCB_CH2",
    "scope_B": "Star_SIPM2_bottom_large_PCB_CH3",
    "scope_C": "small_top_reference_PCB_CH0",
    "scope_D": "small_bottom_reference_PCB_CH1"
  },
  "bias_policy": {
    "overvoltage_V": 3.0,
    "temperature_coefficient_V_per_C": 0.054,
    "large_tile_vbr_reference_temperature_C": 20.4,
    "triangle_vbr_V": 50.512,
    "star_vbr_V": 50.574,
    "small_tile_vbr_proxy_V": 50.543,
    "small_tile_vbr_proxy_reference_temperature_C": 20.4,
    "small_tile_note": "Proxy is the mean measured Vbr of Triangle and Star on this readout. Replace it after measuring each reference SiPM."
  },
  "acquisition": {
    "events": 1000,
    "sample_interval_requested_ns": 2,
    "sample_interval_actual_ns": 4,
    "pre_trigger_ns": 800,
    "post_trigger_ns": 400,
    "probe_attenuation": 10,
    "scope_input_ranges_mV": {
      "A": 200,
      "B": 200,
      "C": 2000,
      "D": 100
    },
    "hardware_trigger": {
      "channel": "D",
      "probe_tip_threshold_mV": 150,
      "auto_trigger_ms": 0
    },
    "offline_reference_selection": {
      "C_positive_excursion_min_mV": 3000,
      "D_positive_excursion_min_mV": 120,
      "absolute_peak_time_difference_max_ns": 40
    }
  }
}
